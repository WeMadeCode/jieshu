{
  "name": "wujie-core",
  "version": "2.1.0",
  "description": "极致的微前端框架",
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "files": [
    "lib",
    "esm"
  ],
  "scripts": {
    "lib": "webpack build --config webpack.config.js",
    "esm": "cross-env BABEL_ENV=esm babel ./src --out-dir ./esm --extensions .ts --source-maps && tsc --emitDeclarationOnly",
    "prepack": "bash build.sh",
    "start": "cross-env BABEL_ENV=esm babel ./src --out-dir ./esm --extensions .ts --source-maps inline --watch & tsc --emitDeclarationOnly",
    "typecheck": "tsc --project tsconfig.json --noEmit --emitDeclarationOnly false && tsc --project __test__/unit/tsconfig.json --noEmit && tsc --project __test__/integration/tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config __test__/unit/vitest.config.mts --coverage",
    "kill-integration-ports": "node scripts/kill-integration-ports.js",
    "install-playwright-browser": "playwright install chromium",
    "test:integration": "pnpm run install-playwright-browser && pnpm run kill-integration-ports && NODE_OPTIONS=--openssl-legacy-provider playwright test --config __test__/integration/playwright.config.mts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "config": {
    "unsafe-perm": true,
    "registry": "https://registry.npmjs.org/"
  },
  "author": "yiludege",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.18.6",
    "@babel/core": "^7.14.6",
    "@babel/plugin-transform-runtime": "^7.18.6",
    "@babel/preset-env": "^7.14.7",
    "@babel/preset-typescript": "^7.18.6",
    "babel-loader": "8.1.0",
    "cross-env": "^7.0.3",
    "sass-loader": "^12.1.0",
    "webpack": "5.98.0",
    "webpack-cli": "^4.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "eslintIgnore": [
    "*.js"
  ],
  "dependencies": {
    "@babel/runtime": "^7.18.6"
  }
}
