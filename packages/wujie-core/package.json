{
  "name": "wujie",
  "version": "2.1.0",
  "description": "极致的微前端框架",
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "files": [
    "lib",
    "esm"
  ],
  "scripts": {
    "lib": "webpack build --config webpack.config.js",
    "esm": "cross-env BABEL_ENV=esm babel ./src --out-dir ./esm --extensions .ts --source-maps && tsc --emitDeclarationOnly",
    "prepack": "bash build.sh",
    "start": "cross-env BABEL_ENV=esm babel ./src --out-dir ./esm --extensions .ts --source-maps inline --watch & tsc --emitDeclarationOnly",
    "typecheck": "tsc --project tsconfig.json --noEmit --emitDeclarationOnly false && tsc --project __test__/unit/tsconfig.json --noEmit && tsc --project __test__/integration/tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "pnpm run lint --fix",
    "test": "npm run test:unit && NODE_OPTIONS=--openssl-legacy-provider npm run test:integration",
    "test:unit": "jest -c __test__/unit/jest.config.js",
    "kill-integration-ports": "node scripts/kill-integration-ports.js",
    "install-puppeteer-browser": "node ./node_modules/puppeteer/install.js",
    "test:integration": "npm run install-puppeteer-browser && npm run kill-integration-ports && NODE_OPTIONS=--openssl-legacy-provider jest -c __test__/integration/jest.config.js --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "config": {
    "unsafe-perm": true,
    "registry": "https://registry.npmjs.org/"
  },
  "author": "yiludege",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.18.6",
    "@babel/core": "^7.14.6",
    "@babel/plugin-transform-runtime": "^7.18.6",
    "@babel/preset-env": "^7.14.7",
    "@babel/preset-typescript": "^7.18.6",
    "@types/jest": "^27.0.3",
    "@types/jest-environment-puppeteer": "^5.0.2",
    "@types/puppeteer": "^5.4.6",
    "babel-loader": "8.1.0",
    "cross-env": "^7.0.3",
    "jest": "^27.3.1",
    "jest-puppeteer": "^6.1.0",
    "puppeteer": "^14.2.1",
    "sass-loader": "^12.1.0",
    "webpack": "5.98.0",
    "webpack-cli": "^4.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "eslintIgnore": [
    "*.js"
  ],
  "dependencies": {
    "@babel/runtime": "^7.18.6"
  }
}
