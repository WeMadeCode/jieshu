{
  "name": "wujie-core",
  "version": "2.1.0",
  "description": "极致的微前端框架",
  "main": "./lib/index.umd.js",
  "module": "./esm-compat/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "webpack": "./esm-compat/index.js",
      "import": "./esm/index.mjs",
      "require": "./lib/index.umd.js",
      "default": "./esm/index.mjs"
    }
  },
  "unpkg": "./lib/index.umd.js",
  "jsdelivr": "./lib/index.umd.js",
  "files": [
    "lib",
    "esm",
    "esm-compat"
  ],
  "scripts": {
    "clean": "rimraf lib esm esm-compat",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:umd && pnpm run build:types",
    "build:esm": "vite build --mode esm && vite build --mode esm-compat",
    "build:umd": "vite build --mode umd",
    "build:types": "tsc --emitDeclarationOnly",
    "lib": "pnpm run build:umd",
    "esm": "pnpm run build:esm && pnpm run build:types",
    "prepack": "pnpm run build",
    "start": "pnpm run build:types && vite build --mode esm --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit --emitDeclarationOnly false && tsc --project __test__/unit/tsconfig.json --noEmit && tsc --project __test__/integration/tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config __test__/unit/vitest.config.mts --coverage",
    "kill-integration-ports": "node scripts/kill-integration-ports.js",
    "install-playwright-browser": "playwright install chromium",
    "test:integration": "pnpm run install-playwright-browser && pnpm run kill-integration-ports && NODE_OPTIONS=--openssl-legacy-provider playwright test --config __test__/integration/playwright.config.mts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "config": {
    "unsafe-perm": true,
    "registry": "https://registry.npmjs.org/"
  },
  "author": "yiludege",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "eslintIgnore": [
    "*.js"
  ]
}
