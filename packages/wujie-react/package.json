{
  "name": "wujie-react",
  "version": "2.1.0",
  "description": "无界微前端React组件封装",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "esm",
    "lib",
    "types"
  ],
  "scripts": {
    "lib": "pnpm run esm && webpack build --config webpack.config.js",
    "esm": "../wujie-core/node_modules/.bin/tsc --project tsconfig.json",
    "types": "pnpm run esm",
    "typecheck": "../wujie-core/node_modules/.bin/tsc --project tsconfig.json",
    "typecheck:public": "../wujie-core/node_modules/.bin/tsc --project tsconfig.test.json",
    "lint": "eslint --ext .ts,.mjs index.ts __test__",
    "prepack": "bash build.sh",
    "start": "../wujie-core/node_modules/.bin/tsc --project tsconfig.json --watch --preserveWatchOutput",
    "test": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:public && node --no-warnings --experimental-vm-modules __test__/functional-runtime.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "config": {
    "unsafe-perm": true,
    "registry": "https://registry.npmjs.org/"
  },
  "author": "yiludege",
  "license": "MIT",
  "dependencies": {
    "prop-types": "^15.8.1",
    "wujie": "workspace:2.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.6",
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "@babel/preset-react": "^7.16.7",
    "babel-loader": "^8.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.2.0",
    "eslint-plugin-react": "^7.29.3",
    "webpack": "5.98.0",
    "webpack-cli": "^4.9.1"
  }
}
