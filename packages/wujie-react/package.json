{
  "name": "wujie-react",
  "version": "2.1.0",
  "description": "无界微前端React组件封装",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "main": "./lib/index.umd.js",
  "module": "./esm/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.mjs",
      "require": "./lib/index.umd.js",
      "default": "./esm/index.mjs"
    }
  },
  "unpkg": "./lib/index.umd.js",
  "jsdelivr": "./lib/index.umd.js",
  "files": [
    "esm",
    "lib",
    "types"
  ],
  "scripts": {
    "clean": "rimraf lib esm types",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:umd && pnpm run build:types",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:types": "tsc --project tsconfig.json",
    "lib": "pnpm run build:umd",
    "esm": "pnpm run build:esm",
    "types": "pnpm run build:types",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project __test__/unit/tsconfig.json --noEmit && pnpm run typecheck:public",
    "typecheck:public": "tsc --project tsconfig.test.json",
    "lint": "eslint index.tsx __test__",
    "lint:fix": "pnpm run lint --fix",
    "start": "pnpm run build:types && vite build --mode esm --watch",
    "test:unit": "vitest run --config __test__/unit/vitest.config.mts --coverage",
    "test:ui": "pnpm run test:unit",
    "test": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:public && pnpm run test:unit && pnpm run test:ui"
  },
  "peerDependencies": {
    "react": ">=17.0.2"
  },
  "author": "yiludege",
  "license": "MIT",
  "dependencies": {
    "wujie-core": "workspace:2.1.0"
  },
  "devDependencies": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "17.0.26",
    "react": "^17.0.2",
    "react-dom": "17.0.2"
  }
}
