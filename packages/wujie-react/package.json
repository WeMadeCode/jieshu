{
  "name": "wujie-react",
  "version": "2.1.0",
  "description": "无界微前端React组件封装",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "esm",
    "lib",
    "types"
  ],
  "scripts": {
    "lib": "pnpm run esm && webpack build --config webpack.config.js",
    "esm": "tsc --project tsconfig.json",
    "types": "pnpm run esm",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project __test__/unit/tsconfig.json --noEmit && pnpm run typecheck:public",
    "typecheck:public": "tsc --project tsconfig.test.json",
    "lint": "eslint index.ts __test__",
    "lint:fix": "pnpm run lint --fix",
    "prepack": "bash build.sh",
    "start": "tsc --project tsconfig.json --watch --preserveWatchOutput",
    "test:unit": "vitest run --config __test__/unit/vitest.config.mts --coverage",
    "test:ui": "pnpm run test:unit",
    "test": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:public && pnpm run test:unit && pnpm run test:ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=17.0.2"
  },
  "config": {
    "unsafe-perm": true,
    "registry": "https://registry.npmjs.org/"
  },
  "author": "yiludege",
  "license": "MIT",
  "dependencies": {
    "wujie": "workspace:2.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.6",
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "@babel/preset-react": "^7.16.7",
    "@types/react": "^17.0.0",
    "@types/react-dom": "17.0.26",
    "babel-loader": "^8.2.3",
    "cross-env": "^7.0.3",
    "react": "^17.0.2",
    "react-dom": "17.0.2",
    "webpack": "5.98.0",
    "webpack-cli": "^4.9.1"
  }
}
