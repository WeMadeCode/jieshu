{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./types",
    "declarationMap": false,
    "downlevelIteration": true,
    "lib": ["DOM", "ES2018"],
    "module": "ES2015",
    "moduleResolution": "Node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "outDir": "./esm",
    "sourceMap": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES5"
  },
  "include": ["index.ts"]
}
