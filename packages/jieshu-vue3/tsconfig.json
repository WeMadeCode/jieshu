{
  "extends": "../../tsconfig.json",
  "include": ["./src/**/*.ts", "./src/**/*.vue"],
  "exclude": ["node_modules", "esm", "lib"],
  "compilerOptions": {
    "isolatedModules": true,
    "declaration": true,
    "declarationDir": "./types",
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "sourceMap": false,
    "skipLibCheck": true
  }
}
