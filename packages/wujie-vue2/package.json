{
  "name": "wujie-vue2",
  "version": "2.1.0",
  "description": "无界微前端Vue2组件封装",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./index.d.ts",
  "files": [
    "esm",
    "lib",
    "index.d.ts"
  ],
  "scripts": {
    "declarations": "../wujie-core/node_modules/.bin/tsc -p tsconfig.declaration.json && cp esm/index.d.ts index.d.ts",
    "check:declarations": "../wujie-core/node_modules/.bin/tsc -p tsconfig.declaration.json && diff -u index.d.ts esm/index.d.ts",
    "typecheck": "pnpm run check:declarations && ../wujie-core/node_modules/.bin/tsc -p tsconfig.type-test.json && ../wujie-core/node_modules/.bin/tsc -p tsconfig.consumer.json",
    "lint": "eslint --ext .ts --ext .mts --ext .cts index.ts __test__",
    "lib": "pnpm run typecheck && pnpm run esm && webpack build --mode=production --config webpack.config.js",
    "esm": "../wujie-core/node_modules/.bin/tsc -p tsconfig.json",
    "prepack": "bash build.sh",
    "start": "../wujie-core/node_modules/.bin/tsc -p tsconfig.json --watch",
    "test": "pnpm run lint && pnpm run typecheck"
  },
  "author": "yiludege",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^2.6.0"
  },
  "config": {
    "unsafe-perm": true,
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "dependencies": {
    "wujie": "workspace:2.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.6",
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "babel-loader": "^8.2.3",
    "cross-env": "^7.0.3",
    "csstype": "^3.1.1",
    "eslint": "^8.2.0",
    "eslint-plugin-vue": "^8.0.3",
    "webpack": "5.98.0",
    "webpack-cli": "^4.9.1"
  }
}
