{
  "name": "jieshu-react",
  "version": "2.1.0",
  "description": "界枢微前端React组件封装",
  "repository": {
    "type": "git",
    "url": "https://github.com/WeMadeCode/jieshu.git"
  },
  "main": "./dist/lib/index.umd.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/lib/index.umd.js",
      "default": "./dist/esm/index.mjs"
    }
  },
  "unpkg": "./dist/lib/index.umd.js",
  "jsdelivr": "./dist/lib/index.umd.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist lib esm types",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:umd && pnpm run build:types",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:types": "tsc --project tsconfig.json",
    "lib": "pnpm run build:umd",
    "esm": "pnpm run build:esm",
    "types": "pnpm run build:types",
    "prepare:consumer": "node __test__/consumer/prepare.mjs",
    "typecheck:source": "tsc --project tsconfig.json --noEmit && tsc --project __test__/unit/tsconfig.json --noEmit && tsc --project __test__/ui/tsconfig.json --noEmit",
    "typecheck:public:built": "pnpm run prepare:consumer && tsc --project tsconfig.test.json",
    "typecheck:public": "pnpm run build && pnpm run typecheck:public:built",
    "typecheck": "pnpm run typecheck:source && pnpm run typecheck:public",
    "lint": "eslint src __test__",
    "lint:fix": "pnpm run lint --fix",
    "start": "pnpm run build:types && vite build --mode esm --watch",
    "test:unit": "vitest run --config __test__/unit/vitest.config.mts --coverage",
    "test:ui:built": "pnpm run prepare:consumer && vitest run --config __test__/ui/vitest.config.mts",
    "test:ui": "pnpm run build && pnpm run test:ui:built",
    "test": "pnpm run build && pnpm run lint && pnpm run typecheck:source && pnpm run typecheck:public:built && pnpm run test:unit && pnpm run test:ui:built"
  },
  "peerDependencies": {
    "react": ">=17.0.2"
  },
  "author": "yiludege",
  "license": "MIT",
  "dependencies": {
    "jieshu-core": "workspace:2.1.0"
  },
  "devDependencies": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "17.0.26",
    "react": "^17.0.2",
    "react-dom": "17.0.2"
  }
}
