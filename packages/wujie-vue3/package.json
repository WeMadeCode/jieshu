{
  "name": "wujie-vue3",
  "version": "2.1.0",
  "description": "无界微前端Vue3组件封装",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/wujie.git"
  },
  "main": "./lib/index.umd.js",
  "module": "./esm-compat/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "webpack": "./esm-compat/index.js",
      "import": "./esm/index.mjs",
      "require": "./lib/index.umd.js",
      "default": "./esm/index.mjs"
    }
  },
  "unpkg": "./lib/index.umd.js",
  "jsdelivr": "./lib/index.umd.js",
  "files": [
    "esm",
    "esm-compat",
    "lib",
    "index.d.ts"
  ],
  "scripts": {
    "clean": "rimraf lib esm esm-compat",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:umd && pnpm run build:types",
    "build:esm": "vite build --mode esm && vite build --mode esm-compat",
    "build:umd": "vite build --mode umd",
    "build:types": "tsc --project tsconfig.json",
    "lib": "pnpm run build:umd",
    "esm": "pnpm run build:esm",
    "prepack": "pnpm run build",
    "start": "pnpm run build:types && vite build --mode esm --watch",
    "typecheck": "tsc -p tsconfig.type-test.json && tsc -p __test__/unit/tsconfig.json --noEmit",
    "lint": "eslint index.ts __test__",
    "lint:fix": "pnpm run lint --fix",
    "test:unit": "vitest run --config __test__/unit/vitest.config.mts --coverage",
    "test:ui": "pnpm run test:unit",
    "test": "pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:ui"
  },
  "author": "yiludege",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "config": {
    "unsafe-perm": true,
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "dependencies": {
    "wujie-core": "workspace:2.1.0"
  },
  "devDependencies": {
    "csstype": "^3.1.1",
    "vue": "^3.0.0"
  }
}
