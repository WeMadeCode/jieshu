{
  "name": "jieshu-project",
  "version": "0.0.0",
  "description": "极致的微前端框架",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build:packages": "pnpm --recursive --filter \"./packages/*\" run build",
    "build:examples": "pnpm run build:packages && pnpm --recursive --workspace-concurrency=1 --filter \"./examples/*\" run build && pnpm --filter jieshu-docs run docs:build && pnpm run assemble:examples",
    "assemble:examples": "node scripts/assemble-examples.mjs",
    "preview:examples": "pnpm run assemble:examples && vite preview --outDir site --host 0.0.0.0 --port 4173 --strictPort --open /demo-main-react/",
    "dev:examples:docs": "pnpm --filter jieshu-docs exec vitepress dev --host 0.0.0.0 --port 5173",
    "start": "WATCHPACK_POLLING=true NODE_OPTIONS=--openssl-legacy-provider pnpm --recursive --parallel --if-present run start",
    "start:children": "WATCHPACK_POLLING=true NODE_OPTIONS=--openssl-legacy-provider pnpm --recursive --parallel --if-present --filter @cloud/jieshu-core --filter @cloud/jieshu-react --filter @cloud/jieshu-vue3 --filter react16 --filter react17 --filter vue2 --filter vue3 --filter vite --filter angular12 run start",
    "start:mains": "WATCHPACK_POLLING=true NODE_OPTIONS=--openssl-legacy-provider pnpm --recursive --parallel --if-present --filter main-react --filter main-react-ts --filter main-vue run start",
    "doc": "pnpm --filter jieshu-docs run docs:dev",
    "clean": "rimraf node_modules \"**/*/node_modules\" \"packages/*/dist\" pnpm-lock.yaml --glob",
    "lint": "eslint . --max-warnings=0",
    "check:examples": "eslint examples --max-warnings=0 && prettier --check examples",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @cloud/jieshu-core --filter @cloud/jieshu-react --filter @cloud/jieshu-vue3 --filter jieshu-docs run typecheck",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "test": "NODE_OPTIONS=--openssl-legacy-provider pnpm --filter @cloud/jieshu-core run test",
    "test:unit": "vitest run --config vitest.config.mts --coverage",
    "test:adapters": "pnpm --filter @cloud/jieshu-react --filter @cloud/jieshu-vue3 test",
    "prepare": "husky install"
  },
  "license": "MIT",
  "lint-staged": {
    "{packages,docs,examples}/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{packages,docs,examples}/**/*.{json,md,yml,yaml,css,scss,less,html}": "prettier --write",
    "*.{js,ts,mjs,cjs,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.1.6",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.55.0",
    "vite": "8.2.2",
    "vitest": "4.0.18",
    "vue-eslint-parser": "10.1.3",
    "vue-tsc": "3.2.4"
  }
}
