{
  "name": "jieshu-project",
  "version": "0.0.0",
  "description": "极致的微前端框架",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider lerna run start --parallel",
    "doc": "lerna run docs:dev",
    "clean": "rimraf node_modules **/*/node_modules packages/*/lib packages/*/esm packages/*/esm-compat",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter wujie-core --filter wujie-react --filter wujie-vue2 --filter wujie-vue3 --filter wujie-docs run typecheck",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "test": "NODE_OPTIONS=--openssl-legacy-provider lerna run test --scope wujie-core",
    "test:unit": "vitest run --config vitest.config.mts --coverage",
    "test:adapters": "pnpm --filter wujie-react --filter wujie-vue2 --filter wujie-vue3 test",
    "prepare": "husky install"
  },
  "license": "MIT",
  "lint-staged": {
    "{packages,docs}/**/*.{js,ts,mjs,cjs,mts,cts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{packages,docs}/**/*.{json,md,yml,yaml,css,scss,less,html}": "prettier --write",
    "*.{js,ts,mjs,cjs,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lerna-lite/cli": "^5.6.1",
    "@lerna-lite/run": "^5.6.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "^17.12.0",
    "husky": "^7.0.4",
    "jsdom": "30.0.1",
    "lint-staged": "^12.4.1",
    "prettier": "3.9.6",
    "rimraf": "^3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.11"
  }
}
